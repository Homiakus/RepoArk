[Unit]
Description=RepoArk durable backup control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/repoark control serve
Restart=on-failure
RestartSec=10
EnvironmentFile=-%h/.config/repoark/repoark.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.repoark %h/.config/repoark

[Install]
WantedBy=default.target
